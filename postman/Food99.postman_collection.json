{
  "info": {
    "_postman_id": "b9f4a7d5-3fd5-4217-8d61-cf6cf78c68f0",
    "name": "99Food Portfolio - API Local",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection para testar todas as rotas /api/v1 do projeto 99Food Portfolio. As rotas protegidas usam Bearer {{access_token}} e o token JWT e renovado automaticamente pelo pre-request da collection."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const skipAutoAuth = pm.variables.get('skip_auto_auth') === true || pm.variables.get('skip_auto_auth') === 'true';",
          "",
          "if (!skipAutoAuth) {",
          "  const baseUrl = pm.collectionVariables.get('base_url') || 'http://127.0.0.1:8000';",
          "  const token = pm.collectionVariables.get('access_token');",
          "  const expiresAt = Number(pm.collectionVariables.get('token_expires_at') || 0);",
          "  const skewMs = 30000;",
          "",
          "  if (!token || Date.now() + skewMs >= expiresAt) {",
          "    pm.sendRequest({",
          "      url: `${baseUrl}/api/v1/login`,",
          "      method: 'POST',",
          "      header: {",
          "        'Content-Type': 'application/json',",
          "        'Accept': 'application/json'",
          "      },",
          "      body: {",
          "        mode: 'raw',",
          "        raw: JSON.stringify({",
          "          login: pm.collectionVariables.get('login') || 'admin',",
          "          senha: pm.collectionVariables.get('senha') || 'senha-segura'",
          "        })",
          "      }",
          "    }, function (err, response) {",
          "      if (err) {",
          "        console.error('Erro login:', err);",
          "        return;",
          "      }",
          "",
          "      let json = {};",
          "      try {",
          "        json = response.json();",
          "      } catch (e) {",
          "        console.error('Login retornou resposta nao JSON:', response.text());",
          "        return;",
          "      }",
          "",
          "      if (!json.access_token) {",
          "        console.error('Login sem token:', json);",
          "        return;",
          "      }",
          "",
          "      pm.collectionVariables.set('access_token', json.access_token);",
          "      pm.collectionVariables.set('token_expires_at', String(Date.now() + ((json.expires_in || 3600) * 1000)));",
          "      console.log('Token atualizado');",
          "    });",
          "  }",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "login",
      "value": "admin"
    },
    {
      "key": "senha",
