    {
      "name": "99Food Webhooks",
      "item": [
        {
          "name": "Receber webhook orderNew",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const raw = pm.request.body.raw;",
                  "const secret = pm.collectionVariables.get('food99_app_secret') || 'sample-app-secret';",
                  "pm.request.headers.upsert({",
                  "  key: 'didi-header-sign',",
                  "  value: CryptoJS.MD5(raw + secret).toString()",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "didi-header-sign",
                "value": ""
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"app_id\": {{food99_app_id}},\n  \"app_shop_id\": \"{{app_shop_id}}\",\n  \"type\": \"orderNew\",\n  \"timestamp\": 1786373203,\n  \"request_id\": \"postman-order-new-001\",\n  \"data\": {\n    \"order_id\": \"990000000001\",\n    \"order_info\": {\n      \"order_id\": \"990000000001\",\n      \"status\": 100,\n      \"order_index\": 1,\n      \"country\": \"BR\",\n      \"timezone\": \"America/Sao_Paulo\",\n      \"pay_type\": 1,\n      \"delivery_type\": 1,\n      \"create_time\": 1786373203,\n      \"pay_time\": 1786373203,\n      \"price\": {\n        \"order_price\": 2990,\n        \"real_price\": 2990,\n        \"real_pay_price\": 2990,\n        \"refund_price\": 0\n      },\n      \"receive_address\": {\n        \"name\": \"Cliente Postman\",\n        \"phone\": \"11999999999\"\n      },\n      \"order_items\": [\n        {\n          \"app_item_id\": \"burger_classico\",\n          \"name\": \"Hamburguer Classico\",\n          \"amount\": 1,\n          \"sku_price\": 2990,\n          \"total_price\": 2990,\n          \"real_price\": 2990\n        }\n      ]\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
